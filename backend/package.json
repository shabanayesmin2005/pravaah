{
  "name": "@pravaah/backend",
  "version": "1.0.0",
  "private": true,
  "description": "PRAVAAH backend – Node.js + TypeScript REST API and WebSocket server",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "seed": "tsx src/scripts/seed.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pravaah/shared": "*",
    "express": "^4.19.2",
    "mongoose": "^8.5.3",
    "ioredis": "^5.4.1",
    "kafkajs": "^2.2.4",
    "socket.io": "^4.7.5",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "zod": "^3.23.8",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.3.1",
    "rate-limit-redis": "^4.2.0",
    "morgan": "^1.10.0",
    "pdfkit": "^0.15.0",
    "csv-stringify": "^6.5.1",
    "multer": "^1.4.5-lts.1",
    "csv-parse": "^5.5.6",
    "uuid": "^10.0.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.11",
    "@types/uuid": "^10.0.0",
    "@types/pdfkit": "^0.13.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2"
  }
}
