# ═══════════════════════════════════════════════════════════════════════════════
# PRAVAAH – Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Node Environment ───────────────────────────────────────────────────────────
NODE_ENV=development          # development | production | test

# ── Backend Server ─────────────────────────────────────────────────────────────
BACKEND_PORT=4000
BACKEND_HOST=0.0.0.0

# ── JWT Authentication ─────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_64_byte_hex_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_generate_another_64_byte_hex_secret
JWT_REFRESH_EXPIRES_IN=7d

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://pravaah_user:CHANGE_ME_mongo_app_password@localhost:27017/pravaah?authSource=pravaah
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=CHANGE_ME_mongo_root_password
MONGO_DB_NAME=pravaah
MONGO_APP_USER=pravaah_user
MONGO_APP_PASSWORD=CHANGE_ME_mongo_app_password

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME_redis_password@localhost:6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# ── Kafka ──────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=pravaah-backend
KAFKA_GROUP_ID_STREAM=pravaah-stream
KAFKA_TOPIC_DETECTIONS=detections
KAFKA_TOPIC_ALERTS=alerts
KAFKA_TOPIC_ANALYTICS=analytics

# ── AI Engine (Python) ─────────────────────────────────────────────────────────
# Path to YOLO vehicle detection model weights (relative to ai-engine/)
YOLO_VEHICLE_MODEL=models/yolov8n.pt
# Path to YOLO plate detection model weights
YOLO_PLATE_MODEL=yasirfaizahmed/license-plate-object-detection
# OCR backend: paddleocr | easyocr
OCR_BACKEND=easyocr
# Minimum plate confidence to publish event (0.0-1.0)
PLATE_MIN_CONFIDENCE=0.6
# Number of frames to hold before emitting a voted plate result
VOTING_WINDOW_FRAMES=10
# Video loop source directory (relative to repo root)
VIDEO_DIR=data/video_samples

# ── Snapshot Storage ──────────────────────────────────────────────────────────
# Directory where the AI engine saves vehicle snapshots
SNAPSHOT_DIR=backend/public/snapshots
# Public URL prefix served by the backend
SNAPSHOT_BASE_URL=http://localhost:4000/snapshots

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000   # 1 minute
RATE_LIMIT_MAX_REQUESTS=100  # requests per window per IP

# ── Data Retention ────────────────────────────────────────────────────────────
# Number of days to keep raw detection events before auto-deletion
RETENTION_DAYS=90

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend (Vite public vars) ────────────────────────────────────────────────
# These must be prefixed with VITE_ to be exposed to the browser
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_WS_URL=http://localhost:4000
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# ── Demo / Replay Mode ─────────────────────────────────────────────────────────
REPLAY_SPEED_MULTIPLIER=2    # 2 = replay at 2× real-time
REPLAY_INPUT_FILE=data/demo_events.jsonl

# ── Demo / Seed Users Passwords (seed script only) ───────────────────────────
# Default passwords for demo role accounts – change after first login
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password
SEED_TRAFFIC_PASSWORD=CHANGE_ME_traffic_password
SEED_POLICE_PASSWORD=CHANGE_ME_police_password
SEED_ANALYST_PASSWORD=CHANGE_ME_analyst_password
