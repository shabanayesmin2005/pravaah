{
  "name": "pravaah",
  "version": "1.0.0",
  "description": "PRAVAAH – AI-powered city-wide vehicle tracking & traffic intelligence platform (SIH 2026)",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "scripts"
  ],
  "scripts": {
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "infra:wipe-all-data": "docker compose --env-file .env -f infra/docker-compose.yml down -v",
    "infra:logs": "docker compose --env-file .env -f infra/docker-compose.yml logs -f",
    "infra:ps": "docker compose --env-file .env -f infra/docker-compose.yml ps",
    "build:shared": "npm run build --workspace=shared",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "test:shared": "npm run test --workspace=shared",
    "test:backend": "npm run test --workspace=backend",
    "seed": "npm run seed --workspace=backend",
    "demo:reset": "bash scripts/reset_demo.sh"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.11",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.5.4"
  }
}
